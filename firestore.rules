rules_version = '2';

// =====================================================================
//  Firestore 보안 규칙
// =====================================================================
//  Firebase 콘솔 → Firestore Database → 규칙 탭에 붙여넣고 "게시".
//
//  기본 원칙
//    - 참가자는 "새로 만들기"만 된다. 수정·삭제는 아무도 못 한다.
//      한번 제출한 응답을 나중에 조작할 수 없게 하기 위해서다.
//    - 매칭 기록도 만들기만 된다. 읽기는 로그인한 운영진만.
//    - 참가자 목록 읽기는 열어둔다. 브라우저에서 매칭을 계산해야 해서다.
//
//  ⚠️ 열어둔 읽기 권한에 대해
//  프로젝트 ID를 아는 사람은 participants 컬렉션을 통째로 읽을 수 있다.
//  즉 참가자들의 인스타 ID가 노출될 수 있다. 무료(Spark) 요금제에서
//  클라이언트 SDK만으로는 이걸 막을 방법이 없다 — 매칭을 계산하려면
//  다른 참가자 문서를 읽어야 하고, Firestore 규칙은 문서 단위라서
//  "특정 필드만 숨기기"가 안 되기 때문이다.
//
//  막아야 한다면 매칭을 Cloud Functions로 옮기고 아래 participants의
//  read를 false로 바꾸면 된다. Functions는 Blaze(종량제) 요금제가
//  필요하다. 자세한 건 SETUP.md 참고.
//
//  ⚠️⚠️ 삭제 권한 — 이 규칙을 게시하기 전에 반드시 읽을 것
//
//  운영진 대시보드의 삭제 기능 때문에 delete 를 "로그인한 사용자"에게
//  열어 뒀다. 이게 안전하려면 조건이 하나 있다:
//
//    Firebase 콘솔 → Authentication → Settings → 사용자 작업
//    → "만들기(가입) 사용 설정"이 **꺼져** 있어야 한다.
//
//  이게 켜져 있으면 누구나 API로 계정을 만들 수 있다. apiKey 는 공개
//  저장소의 js/config.js 에 들어 있으므로, 가입이 열려 있는 채로 이
//  규칙을 게시하면 **아무나 가입해서 참가자 데이터를 전부 지울 수 있다.**
//
//  가입을 끌 수 없는 사정이 있다면, 아래 isStaff() 안의 주석을 풀어
//  운영진 이메일 목록 방식으로 바꾸면 된다.
// =====================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // -----------------------------------------------------------------
    // 참가자
    // -----------------------------------------------------------------
    match /participants/{id} {

      // 매칭 계산과 중복 확인에 필요하다
      allow read: if true;

      // 만들기만 허용하고, 모양이 맞는지 검사한다.
      // 검사를 안 걸면 아무나 임의의 문서를 잔뜩 밀어넣을 수 있다.
      allow create: if isValidParticipant(request.resource.data);

      // 제출한 응답은 아무도 못 고친다. 참가자가 자기 답을 나중에
      // 바꿔치기하는 걸 막기 위해서다.
      allow update: if false;

      // 삭제는 운영진 대시보드용. 위쪽 ⚠️ 주의사항을 반드시 읽을 것.
      allow delete: if isStaff();
    }

    // -----------------------------------------------------------------
    // 매칭 기록
    // -----------------------------------------------------------------
    match /matches/{id} {

      // 운영진(로그인한 사용자)만 볼 수 있다
      allow read: if isStaff();

      allow create: if isValidMatch(request.resource.data);
      allow update: if false;
      allow delete: if isStaff();
    }

    // -----------------------------------------------------------------
    // 참가자 사진
    // -----------------------------------------------------------------
    //  문서 id = 참가자 문서 id. 사진은 선택 항목이라 없을 수 있다.
    //
    //  참가자 문서와 따로 둔 이유는 용량이다. 같이 넣으면 매칭할 때
    //  이성 참가자 전원의 사진까지 내려받게 된다 (100명이면 수 MB).
    //
    //  ⚠️ 읽기가 열려 있다 = 주소를 아는 사람은 참가자 사진을 전부 긁어갈
    //  수 있다. 참가자 화면에서 상대 사진을 보여줘야 해서 어쩔 수 없다.
    //  운영진 판단으로 감수하기로 했다 (3시간짜리 부스 + 행사 후 전량 삭제).
    //  행사가 끝나면 반드시 photos 컬렉션을 지울 것.
    // -----------------------------------------------------------------
    match /photos/{id} {

      allow read: if true;

      allow create: if isValidPhoto(request.resource.data);

      // 남의 사진을 바꿔치기하지 못하게 막는다
      allow update: if false;

      allow delete: if isStaff();
    }

    // 위에서 명시하지 않은 경로는 전부 막는다
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

// ---------------------------------------------------------------------
// 운영진 판별
// ---------------------------------------------------------------------
//  현재는 "로그인했으면 운영진"이다. 콘솔에서 가입을 꺼 두었다는 전제가
//  깔려 있다 (계정을 만들 수 있는 사람 = 콘솔에 들어갈 수 있는 사람).
//
//  더 단단하게 잠그고 싶으면 아래 return 문을 지우고 주석 처리된 쪽을
//  쓰면 된다. 그러면 가입이 열려 있어도 목록에 없는 계정은 아무것도
//  못 지운다.
// ---------------------------------------------------------------------

function isStaff() {
  return request.auth != null;

  // 이메일 목록 방식으로 바꾸려면 위 줄을 지우고 아래를 쓴다:
  // return request.auth != null
  //     && request.auth.token.email_verified == true
  //     && request.auth.token.email in [
  //          'staff1@example.com',
  //          'staff2@example.com'
  //        ];
}

// ---------------------------------------------------------------------
// 검증 함수
// ---------------------------------------------------------------------

function isValidParticipant(d) {
  return d.keys().hasOnly([
           'createdAt', 'nickname', 'instagram', 'gender', 'grade',
           'preferredGrades', 'questionIds', 'answers', 'mbti', 'message',
           'animal'
         ])
      && d.keys().hasAll([
           'createdAt', 'nickname', 'instagram', 'gender', 'grade',
           'preferredGrades', 'mbti'
         ])
      && d.createdAt == request.time
      && d.nickname is string
      && d.nickname.size() > 0 && d.nickname.size() <= 20
      && d.instagram is string
      && d.instagram.size() > 0 && d.instagram.size() <= 40
      // 저장 전에 소문자로 정규화되어 있어야 한다
      && d.instagram == d.instagram.lower()
      && d.gender in ['male', 'female']
      && d.grade is int && d.grade >= 1 && d.grade <= 3
      && d.preferredGrades is list
      && d.preferredGrades.size() > 0 && d.preferredGrades.size() <= 3
      && d.mbti is string && d.mbti.size() == 4
      && (!('message' in d.keys()) || (d.message is string && d.message.size() <= 100))
      // 사진 대신 쓰는 동물상 id ('dog', 'cat' …). 길이만 대충 본다.
      && (!('animal' in d.keys()) || (d.animal is string && d.animal.size() <= 20))
      && (!('questionIds' in d.keys()) || d.questionIds is list)
      && (!('answers' in d.keys()) || d.answers is map);
}

function isValidPhoto(d) {
  return d.keys().hasOnly(['data', 'createdAt'])
      && d.createdAt == request.time
      && d.data is string
      // JPEG data URL 만 받는다. 아무 문자열이나 밀어넣지 못하게.
      && d.data.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$')
      // 문서 한도가 1MiB다. 여유를 두고 자른다.
      && d.data.size() <= 800000;
}

function isValidMatch(d) {
  return d.keys().hasOnly(['matchedAt', 'mbti', 'compatibility', 'a', 'b'])
      && d.matchedAt == request.time
      && d.mbti is string && d.mbti.size() == 4
      && d.a is map && d.b is map
      && (!('compatibility' in d.keys())
          || (d.compatibility is int
              && d.compatibility >= 0 && d.compatibility <= 100));
}
